# AI API Configuration
# Choose your AI provider: openai or openrouter

# For OpenAI: Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# For OpenRouter: Get your API key from https://openrouter.ai/keys
# OpenRouter gives access to multiple AI models (Claude, GPT-4, Mistral, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default AI Provider (openai or openrouter)
AI_PROVIDER=openai

# Default Model
# For OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
# For OpenRouter: anthropic/claude-3.5-sonnet, openai/gpt-4o, google/gemini-pro, etc.
DEFAULT_MODEL=gpt-4o-mini

# Server Configuration
PORT=3000
NODE_ENV=development
